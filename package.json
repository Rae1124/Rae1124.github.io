{
  "name": "student-id-replacement-system",
  "version": "1.1.2",
  "private": true,
  "productName": "Student ID Replacement System",
  "description": "School ID replacement desktop client",
  "author": "Adrielle A. Quiamco",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --experimental-vm-modules --test test/*.test.js",
    "start": "electron .",
    "prepare:icon": "node scripts/prepare-icon.js",
    "build:win": "electron-builder --win --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "ph.school.online-students-id-replacement",
    "productName": "Student ID Replacement System",
    "asar": true,
    "files": [
      "electron/**",
      "renderer/**",
      "auth.js",
      "ui.js",
      "api.js",
      "config.js",
      "state.js",
      "utils.js",
      "ui.css",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Student-ID-Replacement-System-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Student ID Replacement System"
    },
    "portable": {
      "artifactName": "Student-ID-Replacement-System-Portable.${ext}"
    }
  }
}
